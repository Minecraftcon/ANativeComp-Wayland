<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="24dp">

    <!-- Quick launch: icon tiles, no eyebrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <!-- foot tile -->
        <LinearLayout
            android:id="@+id/btn_launch_foot"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/launch_tile_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_terminal"
                android:tint="@color/icon_default"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="foot"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- Thunar tile -->
        <LinearLayout
            android:id="@+id/btn_launch_thunar"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/launch_tile_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_folder"
                android:tint="@color/icon_default"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="files"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

        <!-- galculator tile -->
        <LinearLayout
            android:id="@+id/btn_launch_galculator"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/launch_tile_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_calculator"
                android:tint="@color/icon_default"
                android:layout_marginBottom="5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="calc"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:fontFamily="monospace" />

        </LinearLayout>

    </LinearLayout>

    <!-- Hairline divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="0dp" />

    <!-- Log header: muted label + icon buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System logs"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <!-- Copy icon button -->
        <LinearLayout
            android:id="@+id/btn_log_copy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="2dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_copy"
                android:tint="@color/icon_default" />

        </LinearLayout>

        <!-- Clear icon button -->
        <LinearLayout
            android:id="@+id/btn_log_clear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_trash"
                android:tint="@color/icon_default" />

        </LinearLayout>

    </LinearLayout>

    <!-- Hairline divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="0dp" />

    <!-- Log content -->
    <ScrollView
        android:id="@+id/sv_log_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/tv_log_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[ANativeDrawer] Monitoring started…"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.4" />

    </ScrollView>

</LinearLayout>
